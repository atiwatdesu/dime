rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // บัญชีเดียวที่ใช้แอพได้ (ในแอพพิมพ์ชื่อผู้ใช้ atiwatdesu แอพจะเติม @dime.com ให้)
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['atiwatdesu@dime.com'];
    }

    // ข้อมูลพอร์ต: อ่าน/เขียนได้เฉพาะเจ้าของ uid
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // ราคาและเรต: อ่านได้อย่างเดียว ให้ GitHub Actions (Admin SDK) เป็นผู้เขียน
    match /prices/{sym} {
      allow read: if allowed();
      allow write: if false;
    }
    match /fx/{pair} {
      allow read: if allowed();
      allow write: if false;
    }
  }
}
