rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ล็อกอินด้วยชื่อผู้ใช้: แอพแปลงชื่อผู้ใช้เป็น <ชื่อ>@dime.local
    // ปลอดภัยขึ้นอีกขั้น: เปลี่ยนเป็น request.auth.token.email in ['atiwat@dime.local']
    function allowed() {
      return request.auth != null
        && request.auth.token.email.matches('.*@dime[.]local$');
    }

    // ข้อมูลพอร์ต: อ่าน/เขียนได้เฉพาะเจ้าของ uid
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // ราคาและเรต: อ่านได้อย่างเดียว ให้ GitHub Actions (Admin SDK) เป็นผู้เขียน
    match /prices/{sym} {
      allow read: if allowed();
      allow write: if false;
    }
    match /fx/{pair} {
      allow read: if allowed();
      allow write: if false;
    }
  }
}
